# Railway inyecta DATABASE_URL y PORT automáticamente.
# connection_limit bajo para mantener el consumo mínimo
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gastos?schema=public&connection_limit=5"
PORT=3000
NODE_ENV=development

# Mínimo 32 caracteres: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Client ID de Google Cloud Console (OAuth 2.0, tipo Web)
GOOGLE_CLIENT_ID=

# Orígenes permitidos separados por coma (frontend React)
CORS_ORIGINS=http://localhost:5173,https://developerrm.github.io
