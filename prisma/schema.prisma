generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  googleId         String   @unique @map("google_id")
  email            String   @unique
  name             String?
  themePreferences Json     @default("{}") @map("theme_preferences")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  banks      Bank[]
  categories Category[]
  expenses   Expense[]
  incomes    MonthlyIncome[]

  @@map("users")
}

model Bank {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String
  color         String   @default("#f59e0b")
  accountType   String?  @map("account_type")
  accountNumber String?  @map("account_number")
  createdAt     DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, name])
  @@map("banks")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  icon      String   @default("Tag")
  color     String   @default("#38bdf8")
  createdAt DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, name])
  @@map("categories")
}

model Expense {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  name            String
  bankId          String?  @map("bank_id") @db.Uuid
  categoryId      String?  @map("category_id") @db.Uuid
  billingDay      Int      @default(1) @map("billing_day")
  dueDay          Int      @default(1) @map("due_day")
  estimatedAmount Decimal  @map("estimated_amount") @db.Decimal(12, 2)
  priority        String   @default("medium")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank     Bank?                   @relation(fields: [bankId], references: [id], onDelete: SetNull)
  category Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments MonthlyExpensePayment[]

  @@index([userId])
  @@map("expenses")
}

model MonthlyExpensePayment {
  id        String    @id @default(uuid()) @db.Uuid
  expenseId String    @map("expense_id") @db.Uuid
  monthKey  String    @map("month_key") @db.VarChar(7)
  amount    Decimal?  @db.Decimal(12, 2)
  status    String    @default("pending")
  paidDate  DateTime? @map("paid_date") @db.Date
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, monthKey])
  @@index([monthKey])
  @@map("monthly_expense_payments")
}

model MonthlyIncome {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  monthKey    String   @map("month_key") @db.VarChar(7)
  baseSalary  Decimal  @default(0) @map("base_salary") @db.Decimal(12, 2)
  extraIncome Decimal  @default(0) @map("extra_income") @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthKey])
  @@map("monthly_incomes")
}
